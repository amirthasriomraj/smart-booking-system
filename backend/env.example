# Copy to .env and fill in real values. Never commit .env itself (see
# .gitignore's ".env"/".env.*"/"*.env" rules) — this file is named
# "env.example" (no leading dot) specifically so it isn't caught by those
# same rules and can be committed as a template.

# --- App ---
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_db

# --- JWT ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Frontend origin (used to build links in outgoing emails) ---
FRONTEND_BASE_URL=http://localhost

# --- SMTP / Email (unchanged by Milestone 8) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
EMAIL_FROM=noreply@example.com

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Celery (Milestone 8 — ID-049) ---
# Defaults to the same Redis instance as REDIS_URL; only set these
# separately if the broker/result backend should differ.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Razorpay (Milestone 8 — ID-055) ---
# Test Mode credentials for development/integration; production Route
# activation is a separate deployment/onboarding prerequisite (ID-055) and
# does not block core domain functionality.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
